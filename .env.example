# Copy this file to .env and fill in your key. Never commit .env.
GEMINI_API_KEY=your-key-from-aistudio.google.com
# Leave empty to auto-detect the largest Gemma 4 model your key can use, or set it exactly, e.g. gemma-4-...
GEMMA_MODEL=
GEMMA_VISION_MODEL=
# How hard Gemma 4 thinks: minimal (fast) for routine steps; empty = model default for the SOP compiler
GEMMA_THINKING=minimal
GEMMA_THINKING_DEEP=
# Seconds before a Gemma call is retried
LLM_TIMEOUT_S=180
# auto = live if a key is set, otherwise offline fallbacks
LLM_MODE=auto
# template_first = read text-layer invoices with the fast parser, Gemma for the rest; llm_first = Gemma reads every invoice
EXTRACTION_MODE=template_first
HOURLY_COST_INR=300
