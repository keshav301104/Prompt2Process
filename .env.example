# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your-key-from-aistudio.google.com

# Leave empty to auto-pick the largest Gemma 4 model your key can use
GEMMA_MODEL=
GEMMA_VISION_MODEL=

# auto = live when a key is set, otherwise offline fallbacks
LLM_MODE=auto

# template_first = fast parser for text invoices, Gemma for the rest | llm_first = Gemma reads every invoice
EXTRACTION_MODE=template_first

# used for the "money saved" KPI
HOURLY_COST_INR=300