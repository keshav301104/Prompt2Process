# Copy this file to .env and fill in your key (free at https://aistudio.google.com/apikey). Never commit .env.
GEMINI_API_KEY=your-key-from-aistudio.google.com

# Gemma 4 models — leave GEMMA_MODEL empty to auto-detect the largest Gemma 4 model your key can use.
# Tested setup: fast MoE for routine steps and the SOP compiler, 31B for reading scanned pages and photos.
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_VISION_MODEL=gemma-4-31b-it
# Model for the SOP compiler (hire); empty = GEMMA_MODEL
GEMMA_DEEP_MODEL=gemma-4-26b-a4b-it

# How hard Gemma 4 "thinks" before answering: minimal | low | medium | high | empty = model default
GEMMA_THINKING=minimal
GEMMA_THINKING_DEEP=minimal
# Output budget for compiler calls (thinking counts against it; capped at the model's published limit)
GEMMA_DEEP_MAX_TOKENS=16384
# Seconds Google may spend on one compiler call / on any other call
GEMMA_DEEP_TIMEOUT_S=600
LLM_TIMEOUT_S=180

# auto = live if a key is set, otherwise offline fallbacks | live | offline
LLM_MODE=auto
# template_first = read text-layer documents with the fast parser, Gemma for the rest; llm_first = Gemma reads everything
EXTRACTION_MODE=template_first
# Used for the "cost saved" KPI
HOURLY_COST_INR=300
